# Configure all of these before starting.
DATABASE_URL="postgresql://gitpilot:gitpilot_dev@localhost:5433/gitpilot?schema=public"
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"
GITHUB_TOKEN="github_fine_grained_read_only_token"
GITHUB_OWNER="your-github-username"
GITHUB_REPO="your-repository-name"
GITHUB_AUTHOR="your-github-username"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
